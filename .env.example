# Local synthetic demo only. Never enable on a public deployment.
DOGCLUB_LOCAL_DEMO=1

# Database backend: unset (or "pglite") for the local demo, "supabase" for production PostgreSQL.
DOGCLUB_DB=

# Supabase — The-Dog-Club (Frankfurt, eu-central-1). Values live in .env.local, never in Git.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Session pooler connection string (port 5432), including the database password.
DATABASE_URL=

# Stripe sandbox only. Keep these server-side and use a restricted key where supported.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public origin used to construct Stripe Checkout returns and password-reset links.
APP_URL=http://127.0.0.1:3100

# Random value of at least 16 characters. Vercel sends it as a Bearer token to
# scheduled maintenance routes; leave it unset when cron is not configured.
CRON_SECRET=

# Optional comma-separated origins for a browser-hosted mobile test shell. The native iOS and
# Android Capacitor origins are allowlisted in code; do not use a wildcard here.
MOBILE_ALLOWED_ORIGINS=

# Optional automated account-recovery email. Leave the provider blank for the
# local/manual support flow. Production APP_URL must use HTTPS and the From
# address must belong to a sending domain verified by the provider.
RECOVERY_EMAIL_PROVIDER=
RESEND_API_KEY=
RECOVERY_EMAIL_FROM=
