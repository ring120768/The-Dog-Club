# Local synthetic demo only. Never enable on a public deployment.
DOGCLUB_LOCAL_DEMO=1

# Database backend: unset (or "pglite") for the local demo, "supabase" for production PostgreSQL.
DOGCLUB_DB=

# Supabase — The-Dog-Club (Frankfurt, eu-central-1). Values live in .env.local, never in Git.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Session pooler connection string (port 5432), including the database password.
DATABASE_URL=
